# .env de PRODUÇÃO — copie para o servidor como ~/dietaetreino/.env e preencha.
# Nunca envie este arquivo preenchido para o Git.

APP_NAME="Dieta & Treino"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.seudominio.com.br
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Banco criado no cPanel (o cPanel adiciona um prefixo: usuario_nome)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_dietaetreino
DB_USERNAME=cpaneluser_dtapp
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
